[Unit]
Description=Run jabali-migration-secrets-reap.service daily at 04:30
Documentation=https://github.com/shukiv/jabali-panel/blob/main/docs/adr/0094-migration-importers.md

[Timer]
OnCalendar=*-*-* 04:30:00
RandomizedDelaySec=15min
Persistent=true
Unit=jabali-migration-secrets-reap.service

[Install]
WantedBy=timers.target
