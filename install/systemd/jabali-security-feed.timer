[Unit]
Description=Hourly Jabali security advisory feed check
Documentation=https://github.com/shukiv/jabali-panel/blob/main/docs/runbooks/security-advisory.md

[Timer]
# Hourly, spread over 15 minutes so every server does not fetch the feed in
# the same second.
OnCalendar=hourly
RandomizedDelaySec=15min
Persistent=true
Unit=jabali-security-feed.service

[Install]
WantedBy=timers.target
