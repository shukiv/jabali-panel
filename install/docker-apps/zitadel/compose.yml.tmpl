services:
  zitadel:
    image: {{ .ImageChannel }}
    container_name: jabali-app-{{ .Slug }}
    restart: unless-stopped
    # start-from-init runs the (idempotent) init + setup steps then the
    # server in one command — no separate init job container needed.
    command: start-from-init --masterkeyFromEnv --tlsMode external
    depends_on:
      postgres:
        condition: service_healthy
    environment:
      ZITADEL_MASTERKEY: {{ q (index .Env "MASTERKEY") }}
      # TLS is terminated at the nginx vhost; the container serves plain
      # HTTP. ExternalSecure=true keeps the issuer + cookies on https.
      ZITADEL_EXTERNALDOMAIN: "{{ .Domain }}"
      ZITADEL_EXTERNALPORT: "443"
      ZITADEL_EXTERNALSECURE: "true"
      ZITADEL_TLS_ENABLED: "false"
      ZITADEL_PORT: "8080"
      # Use the built-in v1 login (/ui/login), served by this single
      # container. v4 otherwise defaults the Console to "login v2"
      # (/ui/v2/login), a SEPARATE zitadel-login container needing a PAT +
      # a path-split reverse proxy the catalog can't express -> the login
      # page 404s. Verified: with this false, authorize -> /ui/login.
      ZITADEL_DEFAULTINSTANCE_FEATURES_LOGINV2_REQUIRED: "false"
      # Database — ZITADEL connects as the admin role to create the
      # zitadel role + database on first init, then runs as the zitadel
      # role. Both share the generated POSTGRES_PASSWORD.
      ZITADEL_DATABASE_POSTGRES_HOST: postgres
      ZITADEL_DATABASE_POSTGRES_PORT: "5432"
      ZITADEL_DATABASE_POSTGRES_DATABASE: zitadel
      ZITADEL_DATABASE_POSTGRES_USER_USERNAME: zitadel
      ZITADEL_DATABASE_POSTGRES_USER_PASSWORD: {{ q (index .Env "POSTGRES_PASSWORD") }}
      ZITADEL_DATABASE_POSTGRES_USER_SSL_MODE: disable
      ZITADEL_DATABASE_POSTGRES_ADMIN_USERNAME: postgres
      ZITADEL_DATABASE_POSTGRES_ADMIN_PASSWORD: {{ q (index .Env "POSTGRES_PASSWORD") }}
      ZITADEL_DATABASE_POSTGRES_ADMIN_SSL_MODE: disable
      # First-instance admin. The "Aa1!" suffix guarantees the value
      # meets the default password policy regardless of the random base.
      ZITADEL_FIRSTINSTANCE_ORG_HUMAN_USERNAME: admin
      ZITADEL_FIRSTINSTANCE_ORG_HUMAN_PASSWORD: {{ q (printf "%sAa1!" (index .Env "ADMIN_PASSWORD")) }}
      ZITADEL_FIRSTINSTANCE_ORG_HUMAN_PASSWORDCHANGEREQUIRED: "true"
      # Mark the bootstrap admin's email verified so the first login skips
      # the "Activate User / verify e-mail with code" step — there is no SMTP
      # configured, so a code would never arrive and the admin would be
      # locked out. Login then goes straight to the change-password prompt.
      ZITADEL_FIRSTINSTANCE_ORG_HUMAN_EMAIL_ADDRESS: "admin@{{ .Domain }}"
      ZITADEL_FIRSTINSTANCE_ORG_HUMAN_EMAIL_VERIFIED: "true"
{{- if (index .Env "SMTP_HOST") }}
      # Operator-supplied SMTP (GH #322) — values q-escaped so special chars
      # (e.g. API-key passwords) can't break the rendered compose YAML.
      ZITADEL_DEFAULTINSTANCE_SMTPCONFIGURATION_SMTP_HOST: {{ q (printf "%s:%s" (index .Env "SMTP_HOST") (or (index .Env "SMTP_PORT") "587")) }}
      ZITADEL_DEFAULTINSTANCE_SMTPCONFIGURATION_SMTP_USER: {{ q (index .Env "SMTP_USER") }}
      ZITADEL_DEFAULTINSTANCE_SMTPCONFIGURATION_SMTP_PASSWORD: {{ q (index .Env "SMTP_PASSWORD") }}
      ZITADEL_DEFAULTINSTANCE_SMTPCONFIGURATION_TLS: "true"
      ZITADEL_DEFAULTINSTANCE_SMTPCONFIGURATION_FROM: {{ q (or (index .Env "SMTP_FROM") (printf "admin@%s" .Domain)) }}
      ZITADEL_DEFAULTINSTANCE_SMTPCONFIGURATION_FROMNAME: {{ q (or (index .Env "SMTP_FROM_NAME") "ZITADEL") }}
      ZITADEL_DEFAULTINSTANCE_DOMAINPOLICY_SMTPSENDERADDRESSMATCHESINSTANCEDOMAIN: "false"
{{- end }}
    ports:
{{- with index .Ports "http" }}
      - "{{ .BindInterface }}:{{ .HostPort }}:{{ .ContainerPort }}/{{ .Protocol }}"
{{- end }}
    deploy:
      resources:
        limits:
          cpus: "{{ .CPULimit }}"
          memory: {{ .MemoryLimit }}

  postgres:
    image: postgres:17-alpine@sha256:dc17045ccfd343b49600570ea734b9c4991cf1c3f3302e67df51e3b402dd55c4
    container_name: jabali-app-{{ .Slug }}-postgres
    restart: unless-stopped
    environment:
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: {{ q (index .Env "POSTGRES_PASSWORD") }}
      POSTGRES_DB: postgres
    volumes:
      - {{ .DataRoot }}/postgres:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres"]
      interval: 30s
      timeout: 5s
      retries: 5
      start_period: 20s
