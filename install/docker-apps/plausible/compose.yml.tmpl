services:
  plausible:
    image: {{ .ImageChannel }}
    container_name: jabali-app-{{ .Slug }}
    restart: unless-stopped
    depends_on:
      - postgres
      - clickhouse
    environment:
{{- if (index .Env "SMTP_HOST") }}
      # Operator-supplied SMTP (GH #322) — values q-escaped so special chars
      # (e.g. API-key passwords) can't break the rendered compose YAML.
      SMTP_HOST_ADDR: {{ q (index .Env "SMTP_HOST") }}
      SMTP_HOST_PORT: {{ q (or (index .Env "SMTP_PORT") "587") }}
      SMTP_USER_NAME: {{ q (index .Env "SMTP_USER") }}
      SMTP_USER_PWD: {{ q (index .Env "SMTP_PASSWORD") }}
      SMTP_HOST_SSL_ENABLED: "{{ if eq (index .Env "SMTP_PORT") "465" }}true{{ else }}false{{ end }}"
      MAILER_EMAIL: {{ q (or (index .Env "SMTP_FROM") (printf "plausible@%s" .Domain)) }}
{{- end }}
      BASE_URL: "https://{{ .Domain }}"
      SECRET_KEY_BASE: {{ q (index .Env "SECRET_KEY_BASE") }}
      TOTP_VAULT_KEY: {{ q (index .Env "TOTP_VAULT_KEY") }}
      DATABASE_URL: {{ q (printf "postgres://postgres:%s@postgres:5432/plausible_db" (userinfo (index .Env "POSTGRES_PASSWORD"))) }}
      CLICKHOUSE_DATABASE_URL: "http://clickhouse:8123/plausible_events_db"
    volumes:
      - /etc/timezone:/etc/timezone:ro
    ports:
{{- with index .Ports "http" }}
      - "{{ .BindInterface }}:{{ .HostPort }}:{{ .ContainerPort }}/{{ .Protocol }}"
{{- end }}
    command: >
      sh -c "/entrypoint.sh db createdb &&
             /entrypoint.sh db migrate &&
             /entrypoint.sh run"
    deploy:
      resources:
        limits:
          cpus: "{{ .CPULimit }}"
          memory: {{ .MemoryLimit }}
    healthcheck:
      test: ["CMD-SHELL", "wget --spider -q http://127.0.0.1:8000/api/health || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 60s

  postgres:
    image: postgres:17-alpine@sha256:dc17045ccfd343b49600570ea734b9c4991cf1c3f3302e67df51e3b402dd55c4
    container_name: jabali-app-{{ .Slug }}-postgres
    restart: unless-stopped
    environment:
      POSTGRES_DB: "plausible_db"
      POSTGRES_PASSWORD: {{ q (index .Env "POSTGRES_PASSWORD") }}
    volumes:
      - {{ .DataRoot }}/postgres:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres"]
      interval: 30s
      timeout: 5s
      retries: 5
      start_period: 20s

  clickhouse:
    image: clickhouse/clickhouse-server:25.3-alpine@sha256:a4e8cf46e526a06f4f52d22f7fa8d07472b55d3c896d7ca3f159e249be38ae62
    container_name: jabali-app-{{ .Slug }}-clickhouse
    restart: unless-stopped
    ulimits:
      nofile:
        soft: 262144
        hard: 262144
    volumes:
      - {{ .DataRoot }}/clickhouse:/var/lib/clickhouse
      - {{ .DataRoot }}/clickhouse-logs:/var/log/clickhouse-server
    healthcheck:
      test: ["CMD-SHELL", "wget --spider -q http://127.0.0.1:8123/ping || exit 1"]
      interval: 30s
      timeout: 5s
      retries: 5
      start_period: 30s
