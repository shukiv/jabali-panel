services:
  nextcloud:
    image: {{ .ImageChannel }}
    container_name: jabali-app-{{ .Slug }}
    restart: unless-stopped
    depends_on:
      - db
    environment:
{{- if (index .Env "SMTP_HOST") }}
      # Operator-supplied SMTP (GH #322) — values q-escaped so special chars
      # (e.g. API-key passwords) can't break the rendered compose YAML.
      SMTP_HOST: {{ q (index .Env "SMTP_HOST") }}
      SMTP_PORT: {{ q (or (index .Env "SMTP_PORT") "587") }}
      SMTP_SECURE: "{{ if eq (index .Env "SMTP_PORT") "465" }}ssl{{ else }}tls{{ end }}"
      SMTP_AUTHTYPE: "LOGIN"
      SMTP_NAME: {{ q (index .Env "SMTP_USER") }}
      SMTP_PASSWORD: {{ q (index .Env "SMTP_PASSWORD") }}
      MAIL_FROM_ADDRESS: "no-reply"
      MAIL_DOMAIN: "{{ .Domain }}"
{{- end }}
      MYSQL_HOST: "db"
      MYSQL_DATABASE: "nextcloud"
      MYSQL_USER: "nextcloud"
      MYSQL_PASSWORD: {{ q (index .Env "MYSQL_PASSWORD") }}
      NEXTCLOUD_ADMIN_USER: {{ q (index .Env "NEXTCLOUD_ADMIN_USER") }}
      NEXTCLOUD_ADMIN_PASSWORD: {{ q (index .Env "NEXTCLOUD_ADMIN_PASSWORD") }}
      NEXTCLOUD_TRUSTED_DOMAINS: "{{ .Domain }}"
      OVERWRITEPROTOCOL: "https"
      OVERWRITEHOST: "{{ .Domain }}"
    volumes:
      - {{ .DataRoot }}/nextcloud:/var/www/html
    ports:
{{- with index .Ports "http" }}
      - "{{ .BindInterface }}:{{ .HostPort }}:{{ .ContainerPort }}/{{ .Protocol }}"
{{- end }}
    deploy:
      resources:
        limits:
          cpus: "{{ .CPULimit }}"
          memory: {{ .MemoryLimit }}
    healthcheck:
      test: ["CMD-SHELL", "curl -fsS http://127.0.0.1/status.php -o /dev/null || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 90s

  db:
    image: mariadb:11@sha256:be1ef4fe5f14589325c08a41c76334097ce66c86264b75e1d28342c742782a61
    container_name: jabali-app-{{ .Slug }}-db
    restart: unless-stopped
    command: --transaction-isolation=READ-COMMITTED --log-bin=binlog --binlog-format=ROW --innodb-use-native-aio=0
    environment:
      MYSQL_DATABASE: "nextcloud"
      MYSQL_USER: "nextcloud"
      MYSQL_PASSWORD: {{ q (index .Env "MYSQL_PASSWORD") }}
      MYSQL_ROOT_PASSWORD: {{ q (index .Env "MYSQL_ROOT_PASSWORD") }}
    volumes:
      - {{ .DataRoot }}/db:/var/lib/mysql
    healthcheck:
      test: ["CMD-SHELL", "healthcheck.sh --connect --innodb_initialized"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 60s
