services:
  mediacms:
    image: {{ .ImageChannel }}
    container_name: jabali-app-{{ .Slug }}
    restart: unless-stopped
    depends_on:
      - db
      - redis
    environment:
      POSTGRES_HOST: "db"
      POSTGRES_PORT: "5432"
      POSTGRES_NAME: "mediacms"
      POSTGRES_USER: "mediacms"
      POSTGRES_PASSWORD: {{ q (index .Env "DB_PASSWORD") }}
      REDIS_LOCATION: "redis://redis:6379/1"
      ADMIN_USER: {{ q (index .Env "ADMIN_USER") }}
      ADMIN_EMAIL: {{ q (index .Env "ADMIN_EMAIL") }}
      ADMIN_PASSWORD: {{ q (index .Env "ADMIN_PASSWORD") }}
    volumes:
      - {{ .DataRoot }}/media:/home/mediacms.io/mediacms/media_files
    ports:
{{- with index .Ports "http" }}
      - "{{ .BindInterface }}:{{ .HostPort }}:{{ .ContainerPort }}/{{ .Protocol }}"
{{- end }}
    deploy:
      resources:
        limits:
          cpus: "{{ .CPULimit }}"
          memory: {{ .MemoryLimit }}
    healthcheck:
      test: ["CMD-SHELL", "wget --spider -q http://127.0.0.1:80/ || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 180s

  db:
    image: postgres:17-alpine@sha256:dc17045ccfd343b49600570ea734b9c4991cf1c3f3302e67df51e3b402dd55c4
    container_name: jabali-app-{{ .Slug }}-db
    restart: unless-stopped
    environment:
      POSTGRES_USER: "mediacms"
      POSTGRES_PASSWORD: {{ q (index .Env "DB_PASSWORD") }}
      POSTGRES_DB: "mediacms"
    volumes:
      - {{ .DataRoot }}/postgres:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U mediacms"]
      interval: 30s
      timeout: 5s
      retries: 5
      start_period: 30s

  redis:
    image: docker.io/valkey/valkey:9-alpine@sha256:a35428eba9043cc0b79dbe54100f0c92784f2de00ad09b01182bfb1c5c83d1bd
    container_name: jabali-app-{{ .Slug }}-redis
    restart: unless-stopped
    healthcheck:
      test: ["CMD-SHELL", "valkey-cli ping | grep -q PONG"]
      interval: 30s
      timeout: 5s
      retries: 5
      start_period: 10s
