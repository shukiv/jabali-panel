services:
  grafana:
    image: {{ .ImageChannel }}
    container_name: jabali-app-{{ .Slug }}
    restart: unless-stopped
    environment:
{{- if (index .Env "SMTP_HOST") }}
      # Operator-supplied SMTP (GH #322) — values q-escaped so special chars
      # (e.g. API-key passwords) can't break the rendered compose YAML.
      GF_SMTP_ENABLED: "true"
      GF_SMTP_HOST: {{ q (printf "%s:%s" (index .Env "SMTP_HOST") (or (index .Env "SMTP_PORT") "587")) }}
      GF_SMTP_USER: {{ q (index .Env "SMTP_USER") }}
      GF_SMTP_PASSWORD: {{ q (index .Env "SMTP_PASSWORD") }}
      GF_SMTP_FROM_ADDRESS: {{ q (or (index .Env "SMTP_FROM") (printf "grafana@%s" .Domain)) }}
      GF_SMTP_FROM_NAME: {{ q (or (index .Env "SMTP_FROM_NAME") "Grafana") }}
      GF_SMTP_STARTTLS_POLICY: "{{ if eq (index .Env "SMTP_PORT") "465" }}NoStartTLS{{ else }}OpportunisticStartTLS{{ end }}"
{{- end }}
      # Tells Grafana its public URL so generated links + OAuth redirects
      # are correct behind the TLS-terminating nginx vhost.
      GF_SERVER_ROOT_URL: "https://{{ .Domain }}"
      GF_SERVER_DOMAIN: "{{ .Domain }}"
      GF_SECURITY_ADMIN_USER: "admin"
      GF_SECURITY_ADMIN_PASSWORD: {{ q (index .Env "ADMIN_PASSWORD") }}
      GF_USERS_ALLOW_SIGN_UP: "false"
    volumes:
      - {{ .DataRoot }}/data:/var/lib/grafana
    ports:
{{- with index .Ports "http" }}
      - "{{ .BindInterface }}:{{ .HostPort }}:{{ .ContainerPort }}/{{ .Protocol }}"
{{- end }}
    deploy:
      resources:
        limits:
          cpus: "{{ .CPULimit }}"
          memory: {{ .MemoryLimit }}
