services:
  snipe-it:
    image: {{ .ImageChannel }}
    container_name: jabali-app-{{ .Slug }}
    restart: unless-stopped
    depends_on:
      - db
    environment:
{{- if (index .Env "SMTP_HOST") }}
      # Operator-supplied SMTP (GH #322) — values q-escaped so special chars
      # (e.g. API-key passwords) can't break the rendered compose YAML.
      MAIL_MAILER: "smtp"
      MAIL_HOST: {{ q (index .Env "SMTP_HOST") }}
      MAIL_PORT: {{ q (or (index .Env "SMTP_PORT") "587") }}
      MAIL_USERNAME: {{ q (index .Env "SMTP_USER") }}
      MAIL_PASSWORD: {{ q (index .Env "SMTP_PASSWORD") }}
      MAIL_FROM_ADDR: {{ q (or (index .Env "SMTP_FROM") (printf "snipeit@%s" .Domain)) }}
      MAIL_FROM_NAME: {{ q (or (index .Env "SMTP_FROM_NAME") "Snipe-IT") }}
      MAIL_TLS_VERIFY_PEER: "false"
{{- end }}
      APP_ENV: "production"
      APP_URL: "https://{{ .Domain }}"
      APP_KEY: {{ q (index .Env "APP_KEY") }}
      APP_TRUSTED_PROXIES: "*"
      DB_CONNECTION: "mysql"
      DB_HOST: "db"
      DB_PORT: "3306"
      DB_DATABASE: "snipeit"
      DB_USERNAME: "snipeit"
      DB_PASSWORD: {{ q (index .Env "DB_PASSWORD") }}
    volumes:
      - {{ .DataRoot }}/data:/var/lib/snipeit
    ports:
{{- with index .Ports "http" }}
      - "{{ .BindInterface }}:{{ .HostPort }}:{{ .ContainerPort }}/{{ .Protocol }}"
{{- end }}
    deploy:
      resources:
        limits:
          cpus: "{{ .CPULimit }}"
          memory: {{ .MemoryLimit }}
    healthcheck:
      test: ["CMD-SHELL", "curl -fsS http://127.0.0.1/ -o /dev/null || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 90s

  db:
    image: mariadb:11@sha256:be1ef4fe5f14589325c08a41c76334097ce66c86264b75e1d28342c742782a61
    container_name: jabali-app-{{ .Slug }}-db
    restart: unless-stopped
    environment:
      MYSQL_DATABASE: "snipeit"
      MYSQL_USER: "snipeit"
      MYSQL_PASSWORD: {{ q (index .Env "DB_PASSWORD") }}
      MYSQL_ROOT_PASSWORD: {{ q (index .Env "MYSQL_ROOT_PASSWORD") }}
    volumes:
      - {{ .DataRoot }}/db:/var/lib/mysql
    healthcheck:
      test: ["CMD-SHELL", "healthcheck.sh --connect --innodb_initialized"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 60s
