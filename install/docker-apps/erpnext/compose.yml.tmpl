services:
  # --- one-shot: write common_site_config (db + redis endpoints) ---
  configurator:
    image: {{ .ImageChannel }}
    container_name: jabali-app-{{ .Slug }}-configurator
    depends_on:
      db:
        condition: service_healthy
      redis-cache:
        condition: service_started
      redis-queue:
        condition: service_started
    entrypoint: ["bash", "-c"]
    command:
      - >
        [ -f sites/common_site_config.json ] || echo '{}' > sites/common_site_config.json;
        ls -1 apps > sites/apps.txt;
        bench set-config -g db_host $$DB_HOST;
        bench set-config -gp db_port $$DB_PORT;
        bench set-config -g redis_cache "redis://$$REDIS_CACHE";
        bench set-config -g redis_queue "redis://$$REDIS_QUEUE";
        bench set-config -g redis_socketio "redis://$$REDIS_QUEUE";
        bench set-config -gp socketio_port $$SOCKETIO_PORT;
    environment:
      DB_HOST: db
      DB_PORT: "3306"
      REDIS_CACHE: redis-cache:6379
      REDIS_QUEUE: redis-queue:6379
      SOCKETIO_PORT: "9000"
    volumes:
      - {{ .DataRoot }}/sites:/home/frappe/frappe-bench/sites
      - {{ .DataRoot }}/logs:/home/frappe/frappe-bench/logs

  # --- one-shot: create the Frappe site + install ERPNext (first boot only) ---
  create-site:
    image: {{ .ImageChannel }}
    container_name: jabali-app-{{ .Slug }}-create-site
    depends_on:
      configurator:
        condition: service_completed_successfully
    entrypoint: ["bash", "-c"]
    command:
      - >
        if [ -f "sites/frontend/site_config.json" ]; then
          echo "site already exists, skipping create";
          exit 0;
        fi;
        bench new-site
        --mariadb-user-host-login-scope='%'
        --admin-password="$$ADMIN_PASSWORD"
        --db-root-username=root
        --db-root-password="$$DB_ROOT_PASSWORD"
        --install-app erpnext
        --set-default frontend;
    environment:
      ADMIN_PASSWORD: {{ q (index .Env "ADMIN_PASSWORD") }}
      DB_ROOT_PASSWORD: {{ q (index .Env "DB_ROOT_PASSWORD") }}
    volumes:
      - {{ .DataRoot }}/sites:/home/frappe/frappe-bench/sites
      - {{ .DataRoot }}/logs:/home/frappe/frappe-bench/logs

  backend:
    image: {{ .ImageChannel }}
    container_name: jabali-app-{{ .Slug }}-backend
    restart: unless-stopped
    depends_on:
      create-site:
        condition: service_completed_successfully
    volumes:
      - {{ .DataRoot }}/sites:/home/frappe/frappe-bench/sites
      - {{ .DataRoot }}/logs:/home/frappe/frappe-bench/logs
    deploy:
      resources:
        limits:
          cpus: "{{ .CPULimit }}"
          memory: {{ .MemoryLimit }}

  frontend:
    image: {{ .ImageChannel }}
    container_name: jabali-app-{{ .Slug }}
    restart: unless-stopped
    depends_on:
      backend:
        condition: service_started
      websocket:
        condition: service_started
    command: ["nginx-entrypoint.sh"]
    environment:
      BACKEND: backend:8000
      FRAPPE_SITE_NAME_HEADER: frontend
      SOCKETIO: websocket:9000
      UPSTREAM_REAL_IP_ADDRESS: 127.0.0.1
      UPSTREAM_REAL_IP_HEADER: X-Forwarded-For
      UPSTREAM_REAL_IP_RECURSIVE: "off"
    volumes:
      - {{ .DataRoot }}/sites:/home/frappe/frappe-bench/sites
      - {{ .DataRoot }}/logs:/home/frappe/frappe-bench/logs
    ports:
{{- with index .Ports "http" }}
      - "{{ .BindInterface }}:{{ .HostPort }}:{{ .ContainerPort }}/{{ .Protocol }}"
{{- end }}

  websocket:
    image: {{ .ImageChannel }}
    container_name: jabali-app-{{ .Slug }}-websocket
    restart: unless-stopped
    depends_on:
      create-site:
        condition: service_completed_successfully
    command: ["node", "/home/frappe/frappe-bench/apps/frappe/socketio.js"]
    volumes:
      - {{ .DataRoot }}/sites:/home/frappe/frappe-bench/sites
      - {{ .DataRoot }}/logs:/home/frappe/frappe-bench/logs

  queue-long:
    image: {{ .ImageChannel }}
    container_name: jabali-app-{{ .Slug }}-queue-long
    restart: unless-stopped
    depends_on:
      create-site:
        condition: service_completed_successfully
    command: ["bench", "worker", "--queue", "long,default,short"]
    volumes:
      - {{ .DataRoot }}/sites:/home/frappe/frappe-bench/sites
      - {{ .DataRoot }}/logs:/home/frappe/frappe-bench/logs

  queue-short:
    image: {{ .ImageChannel }}
    container_name: jabali-app-{{ .Slug }}-queue-short
    restart: unless-stopped
    depends_on:
      create-site:
        condition: service_completed_successfully
    command: ["bench", "worker", "--queue", "short,default"]
    volumes:
      - {{ .DataRoot }}/sites:/home/frappe/frappe-bench/sites
      - {{ .DataRoot }}/logs:/home/frappe/frappe-bench/logs

  scheduler:
    image: {{ .ImageChannel }}
    container_name: jabali-app-{{ .Slug }}-scheduler
    restart: unless-stopped
    depends_on:
      create-site:
        condition: service_completed_successfully
    command: ["bench", "schedule"]
    volumes:
      - {{ .DataRoot }}/sites:/home/frappe/frappe-bench/sites
      - {{ .DataRoot }}/logs:/home/frappe/frappe-bench/logs

  db:
    image: mariadb:11.8@sha256:be1ef4fe5f14589325c08a41c76334097ce66c86264b75e1d28342c742782a61
    container_name: jabali-app-{{ .Slug }}-db
    restart: unless-stopped
    command:
      - --character-set-server=utf8mb4
      - --collation-server=utf8mb4_unicode_ci
      - --skip-character-set-client-handshake
    environment:
      MYSQL_ROOT_PASSWORD: {{ q (index .Env "DB_ROOT_PASSWORD") }}
      MARIADB_ROOT_PASSWORD: {{ q (index .Env "DB_ROOT_PASSWORD") }}
    volumes:
      - {{ .DataRoot }}/db-data:/var/lib/mysql
    healthcheck:
      test: ["CMD", "healthcheck.sh", "--connect", "--innodb_initialized"]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 30s

  redis-cache:
    image: redis:7-alpine@sha256:6ab0b6e7381779332f97b8ca76193e45b0756f38d4c0dcda72dbb3c32061ab99
    container_name: jabali-app-{{ .Slug }}-redis-cache
    restart: unless-stopped

  redis-queue:
    image: redis:7-alpine@sha256:6ab0b6e7381779332f97b8ca76193e45b0756f38d4c0dcda72dbb3c32061ab99
    container_name: jabali-app-{{ .Slug }}-redis-queue
    restart: unless-stopped
    volumes:
      - {{ .DataRoot }}/redis-queue-data:/data
