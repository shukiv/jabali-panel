services:
  n8n:
    image: {{ .ImageChannel }}
    container_name: jabali-app-{{ .Slug }}
    restart: unless-stopped
    environment:
{{- if (index .Env "SMTP_HOST") }}
      # Operator-supplied SMTP (GH #322) — values q-escaped so special chars
      # (e.g. API-key passwords) can't break the rendered compose YAML.
      N8N_EMAIL_MODE: "smtp"
      N8N_SMTP_HOST: {{ q (index .Env "SMTP_HOST") }}
      N8N_SMTP_PORT: "{{ or (index .Env "SMTP_PORT") "587" }}"
      N8N_SMTP_USER: {{ q (index .Env "SMTP_USER") }}
      N8N_SMTP_PASS: {{ q (index .Env "SMTP_PASSWORD") }}
      N8N_SMTP_SENDER: {{ q (or (index .Env "SMTP_FROM") (printf "n8n@%s" .Domain)) }}
      N8N_SMTP_SSL: "{{ if eq (index .Env "SMTP_PORT") "465" }}true{{ else }}false{{ end }}"
{{- end }}
      N8N_HOST: "0.0.0.0"
      WEBHOOK_URL: "https://{{ .Domain }}/"
      N8N_EDITOR_BASE_URL: "https://{{ .Domain }}/"
{{- range $name, $val := .Env }}
{{- /* SMTP_* map onto N8N_SMTP_* above; N8N_HOST / WEBHOOK_URL /
       N8N_EDITOR_BASE_URL are template-owned — re-emitting them here
       produced duplicate YAML keys docker compose refuses to parse
       (GH: n8n install failed with "mapping key already defined"). */}}
{{- if not (or (hasPrefix $name "SMTP_") (eq $name "N8N_HOST") (eq $name "WEBHOOK_URL") (eq $name "N8N_EDITOR_BASE_URL")) }}
      {{ $name }}: {{ q $val }}
{{- end }}
{{- end }}
    volumes:
      - {{ .DataRoot }}/data:/home/node/.n8n
    ports:
{{- with index .Ports "http" }}
      - "{{ .BindInterface }}:{{ .HostPort }}:{{ .ContainerPort }}/{{ .Protocol }}"
{{- end }}
    deploy:
      resources:
        limits:
          cpus: "{{ .CPULimit }}"
          memory: {{ .MemoryLimit }}
    healthcheck:
      test: ["CMD-SHELL", "wget --spider -q http://127.0.0.1:5678/healthz || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 30s
