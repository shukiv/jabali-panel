services:
  rocketchat:
    image: {{ .ImageChannel }}
    container_name: jabali-app-{{ .Slug }}
    restart: unless-stopped
    depends_on:
      mongodb:
        condition: service_healthy
    environment:
{{- if (index .Env "SMTP_HOST") }}
      # Operator-supplied SMTP (GH #322) — values q-escaped so special chars
      # (e.g. API-key passwords) can't break the rendered compose YAML.
      OVERWRITE_SETTING_SMTP_Host: {{ q (index .Env "SMTP_HOST") }}
      OVERWRITE_SETTING_SMTP_Port: {{ q (or (index .Env "SMTP_PORT") "587") }}
      OVERWRITE_SETTING_SMTP_Username: {{ q (index .Env "SMTP_USER") }}
      OVERWRITE_SETTING_SMTP_Password: {{ q (index .Env "SMTP_PASSWORD") }}
      OVERWRITE_SETTING_SMTP_Protocol: "{{ if eq (index .Env "SMTP_PORT") "465" }}smtps{{ else }}smtp{{ end }}"
      OVERWRITE_SETTING_From_Email: {{ q (or (index .Env "SMTP_FROM") (printf "rocketchat@%s" .Domain)) }}
{{- end }}
      PORT: "3000"
      ROOT_URL: "{{ if .Domain }}https://{{ .Domain }}{{ else }}http://localhost:3000{{ end }}"
      MONGO_URL: "mongodb://mongodb:27017/rocketchat?replicaSet=rs0"
      MONGO_OPLOG_URL: "mongodb://mongodb:27017/local?replicaSet=rs0"
      DEPLOY_METHOD: "docker"
      # Pre-create the admin so the install isn't stuck on the setup wizard.
      ADMIN_USERNAME: {{ q (index .Env "ROCKETCHAT_ADMIN_USERNAME") }}
      ADMIN_PASS: {{ q (index .Env "ROCKETCHAT_ADMIN_PASSWORD") }}
      ADMIN_EMAIL: {{ q (index .Env "ROCKETCHAT_ADMIN_EMAIL") }}
      OVERWRITE_SETTING_Show_Setup_Wizard: "completed"
    volumes:
      - {{ .DataRoot }}/uploads:/app/uploads
    ports:
{{- with index .Ports "http" }}
      - "{{ .BindInterface }}:{{ .HostPort }}:{{ .ContainerPort }}/{{ .Protocol }}"
{{- end }}
    deploy:
      resources:
        limits:
          cpus: "{{ .CPULimit }}"
          memory: {{ .MemoryLimit }}
    healthcheck:
      test: ["CMD", "node", "-e", "require('http').get('http://127.0.0.1:3000/api/info',r=>process.exit(r.statusCode===200?0:1)).on('error',()=>process.exit(1))"]
      interval: 30s
      timeout: 10s
      retries: 10
      start_period: 120s

  # Rocket.Chat 8 needs MongoDB 8.0. Installs from before 2026-08 keep their
  # database in mongo/ on MongoDB 6.0, which 8.0 cannot open. The two one-shots
  # below copy the rocketchat database into mongo8/ once: mongo-export dumps it
  # with MongoDB 6.0, mongo-import restores it with 8.0, and Rocket.Chat then
  # runs its own migrations (it has every one since 6.13.1). mongo/ keeps its
  # data, so a rollback to the old compose still finds it. The agent stops
  # the old containers first (stop_before_recreate), so nothing writes to
  # mongo/ while it is copied. Both exit at once when there is nothing to do.
  mongo-export:
    image: mongo:6.0@sha256:8b6d8f5bbedb25cb73517b65cf99f13aeb75ad5b157a56c479287a840bbad3ac
    container_name: jabali-app-{{ .Slug }}-mongo-export
    restart: "no"
    entrypoint: ["/bin/bash", "-c"]
    command:
      - |
        set -eu
        if [ ! -e /data/db/WiredTiger ]; then
          echo "no MongoDB 6.0 database to move"; exit 0
        fi
        # mongo/ is copied again when it was written after the last copy
        # (the old compose ran again after a rollback).
        if [ -e /mongo8/.jabali-imported ] && [ ! /data/db/WiredTiger.turtle -nt /mongo8/.jabali-imported ]; then
          echo "already moved to MongoDB 8.0"; exit 0
        fi
        # The image's own entrypoint, skipped here, gives the files to mongodb.
        find /data/db \! -user mongodb -exec chown mongodb:mongodb '{}' +
        gosu mongodb mongod --dbpath /data/db --bind_ip 127.0.0.1 --fork --logpath /tmp/mongod.log
        for i in $$(seq 1 120); do
          mongosh --quiet --eval 'quit(db.adminCommand({ping: 1}).ok ? 0 : 1)' >/dev/null 2>&1 && break
          sleep 1
        done
        rm -f /upgrade/rocketchat.archive.new
        mongodump --db rocketchat --archive=/upgrade/rocketchat.archive.new --gzip
        gosu mongodb mongod --dbpath /data/db --shutdown
        mv /upgrade/rocketchat.archive.new /upgrade/rocketchat.archive
        echo "exported the MongoDB 6.0 database"
    volumes:
      - {{ .DataRoot }}/mongo:/data/db
      - {{ .DataRoot }}/mongo8:/mongo8:ro
      - {{ .DataRoot }}/mongo-upgrade:/upgrade

  mongo-import:
    image: mongo:8.0@sha256:4a4ab5d4834207389e0d7270fac988e21ffedccecba77991a552f755df229907
    container_name: jabali-app-{{ .Slug }}-mongo-import
    restart: "no"
    depends_on:
      mongo-export:
        condition: service_completed_successfully
    entrypoint: ["/bin/bash", "-c"]
    command:
      - |
        set -eu
        a=/upgrade/rocketchat.archive
        if [ ! -e "$$a" ]; then
          echo "nothing to import"; exit 0
        fi
        if [ -e /data/db/.jabali-imported ] && [ ! "$$a" -nt /data/db/.jabali-imported ]; then
          echo "already imported"; exit 0
        fi
        # Only a database this step made, finished or not, is replaced.
        if [ -n "$$(ls -A /data/db)" ] && [ ! -e /data/db/.jabali-imported ] && [ ! -e /data/db/.jabali-import-running ]; then
          echo "mongo8/ holds a database this import did not make; not replacing it" >&2; exit 1
        fi
        find /data/db -mindepth 1 -delete
        touch /data/db/.jabali-import-running
        chown -R mongodb:mongodb /data/db
        gosu mongodb mongod --dbpath /data/db --bind_ip 127.0.0.1 --fork --logpath /tmp/mongod.log
        for i in $$(seq 1 120); do
          mongosh --quiet --eval 'quit(db.adminCommand({ping: 1}).ok ? 0 : 1)' >/dev/null 2>&1 && break
          sleep 1
        done
        mongorestore --archive="$$a" --gzip --nsInclude='rocketchat.*'
        gosu mongodb mongod --dbpath /data/db --shutdown
        rm /data/db/.jabali-import-running
        touch /data/db/.jabali-imported
        rm "$$a"
        echo "imported into MongoDB 8.0"
    volumes:
      - {{ .DataRoot }}/mongo8:/data/db
      - {{ .DataRoot }}/mongo-upgrade:/upgrade

  mongodb:
    image: mongo:8.0@sha256:4a4ab5d4834207389e0d7270fac988e21ffedccecba77991a552f755df229907
    container_name: jabali-app-{{ .Slug }}-mongo
    restart: unless-stopped
    depends_on:
      mongo-import:
        condition: service_completed_successfully
    command: ["mongod", "--replSet", "rs0", "--bind_ip_all"]
    volumes:
      - {{ .DataRoot }}/mongo8:/data/db
    healthcheck:
      # Initiate the single-node replica set on first boot, then report
      # healthy once it's PRIMARY. Idempotent — re-running rs.initiate on an
      # already-initiated set is caught and ignored.
      test: ["CMD-SHELL", "mongosh --quiet --eval \"try{rs.status().ok}catch(e){rs.initiate({_id:'rs0',members:[{_id:0,host:'mongodb:27017'}]}).ok}\" | grep -q 1"]
      interval: 15s
      timeout: 10s
      retries: 20
      start_period: 20s
