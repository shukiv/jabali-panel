services:
  linkwarden:
    image: {{ .ImageChannel }}
    container_name: jabali-app-{{ .Slug }}
    restart: unless-stopped
    depends_on:
      - db
    environment:
{{- if (index .Env "SMTP_HOST") }}
      # Operator-supplied SMTP (GH #322) — values q-escaped so special chars
      # (e.g. API-key passwords) can't break the rendered compose YAML.
      NEXT_PUBLIC_EMAIL_PROVIDER: "true"
      EMAIL_FROM: {{ q (or (index .Env "SMTP_FROM") (printf "linkwarden@%s" .Domain)) }}
      EMAIL_SERVER: {{ $scheme := "smtp" }}{{ if eq (index .Env "SMTP_PORT") "465" }}{{ $scheme = "smtps" }}{{ end }}{{ q (printf "%s://%s:%s@%s:%s" $scheme (userinfo (index .Env "SMTP_USER")) (userinfo (index .Env "SMTP_PASSWORD")) (index .Env "SMTP_HOST") (or (index .Env "SMTP_PORT") "587")) }}
{{- end }}
      DATABASE_URL: {{ q (printf "postgresql://postgres:%s@db:5432/postgres" (userinfo (index .Env "POSTGRES_PASSWORD"))) }}
      NEXTAUTH_SECRET: {{ q (index .Env "NEXTAUTH_SECRET") }}
      NEXTAUTH_URL: "https://{{ .Domain }}/api/v1/auth"
      NEXT_PUBLIC_DISABLE_REGISTRATION: "false"
    volumes:
      - {{ .DataRoot }}/app:/data/data
    ports:
{{- with index .Ports "http" }}
      - "{{ .BindInterface }}:{{ .HostPort }}:{{ .ContainerPort }}/{{ .Protocol }}"
{{- end }}
    deploy:
      resources:
        limits:
          cpus: "{{ .CPULimit }}"
          memory: {{ .MemoryLimit }}
    healthcheck:
      # linkwarden's image ships curl, not wget (wget --spider returned
      # "wget: not found" -> container stuck unhealthy -> updates failed the
      # 5m healthcheck-converge watchdog. curl is present at /usr/bin/curl.
      test: ["CMD-SHELL", "curl -fsS --max-time 5 -o /dev/null http://127.0.0.1:3000/ || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 60s

  db:
    image: postgres:17-alpine@sha256:dc17045ccfd343b49600570ea734b9c4991cf1c3f3302e67df51e3b402dd55c4
    container_name: jabali-app-{{ .Slug }}-db
    restart: unless-stopped
    environment:
      POSTGRES_PASSWORD: {{ q (index .Env "POSTGRES_PASSWORD") }}
    volumes:
      - {{ .DataRoot }}/db:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres"]
      interval: 30s
      timeout: 5s
      retries: 5
      start_period: 20s
