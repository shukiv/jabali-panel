services:
  flarum:
    image: {{ .ImageChannel }}
    container_name: jabali-app-{{ .Slug }}
    restart: unless-stopped
    depends_on:
      db:
        condition: service_healthy
    environment:
      FORUM_URL: "https://{{ .Domain }}"
      DB_HOST: "db"
      DB_NAME: "flarum"
      DB_USER: "flarum"
      DB_PASS: {{ q (index .Env "DB_PASS") }}
      FLARUM_ADMIN_USER: {{ q (index .Env "FLARUM_ADMIN_USER") }}
      FLARUM_ADMIN_PASS: {{ q (index .Env "FLARUM_ADMIN_PASS") }}
      FLARUM_ADMIN_MAIL: "admin@{{ .Domain }}"
      FLARUM_TITLE: {{ q (index .Env "FLARUM_TITLE") }}
    volumes:
      - {{ .DataRoot }}/assets:/flarum/app/public/assets
      - {{ .DataRoot }}/extensions:/flarum/app/extensions
      - {{ .DataRoot }}/storagelogs:/flarum/app/storage/logs
    ports:
{{- with index .Ports "http" }}
      - "{{ .BindInterface }}:{{ .HostPort }}:{{ .ContainerPort }}/{{ .Protocol }}"
{{- end }}
    deploy:
      resources:
        limits:
          cpus: "{{ .CPULimit }}"
          memory: {{ .MemoryLimit }}
    healthcheck:
      test: ["CMD-SHELL", "wget --spider -q http://127.0.0.1:8888/ || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 90s

  db:
    image: mariadb:11@sha256:be1ef4fe5f14589325c08a41c76334097ce66c86264b75e1d28342c742782a61
    container_name: jabali-app-{{ .Slug }}-db
    restart: unless-stopped
    command: --transaction-isolation=READ-COMMITTED --innodb-use-native-aio=0
    environment:
      MYSQL_DATABASE: "flarum"
      MYSQL_USER: "flarum"
      MYSQL_PASSWORD: {{ q (index .Env "DB_PASS") }}
      MYSQL_ROOT_PASSWORD: {{ q (index .Env "MYSQL_ROOT_PASSWORD") }}
    volumes:
      - {{ .DataRoot }}/db:/var/lib/mysql
    healthcheck:
      test: ["CMD-SHELL", "healthcheck.sh --connect --innodb_initialized"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 60s
