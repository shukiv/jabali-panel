# Bigcapital — multi-tenant accounting platform. The Envoy proxy is the
# single HTTP entry point (jabali's nginx vhost reverse-proxies to it): it
# routes /api -> server (NestJS) and / -> webapp (React). One-shot
# "migration" (system + tenants schema) and "createbucket" (MinIO bucket)
# steps run to completion before the server starts. Self-signup onboarding
# creates the first organization + owner; each org gets its own database,
# which is why the DB user is granted global privileges (see db_grant).
configs:
  envoy_config:
    content: |
      static_resources:
        listeners:
          - name: listener_0
            address:
              socket_address: { address: 0.0.0.0, port_value: 80 }
            filter_chains:
              - filters:
                  - name: envoy.filters.network.http_connection_manager
                    typed_config:
                      '@type': type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager
                      stat_prefix: ingress_http
                      route_config:
                        name: local_route
                        virtual_hosts:
                          - name: backend
                            domains: ['*']
                            routes:
                              - match: { prefix: '/api' }
                                route: { cluster: dynamic_server }
                              - match: { prefix: '/' }
                                route: { cluster: webapp }
                      http_filters:
                        - name: envoy.filters.http.router
                          typed_config:
                            "@type": type.googleapis.com/envoy.extensions.filters.http.router.v3.Router
        clusters:
          - name: dynamic_server
            connect_timeout: 0.25s
            type: STRICT_DNS
            dns_lookup_family: V4_ONLY
            lb_policy: ROUND_ROBIN
            load_assignment:
              cluster_name: dynamic_server
              endpoints:
                - lb_endpoints:
                    - endpoint:
                        address:
                          socket_address: { address: server, port_value: 3000 }
          - name: webapp
            connect_timeout: 0.25s
            type: STRICT_DNS
            dns_lookup_family: V4_ONLY
            lb_policy: ROUND_ROBIN
            load_assignment:
              cluster_name: webapp
              endpoints:
                - lb_endpoints:
                    - endpoint:
                        address:
                          socket_address: { address: webapp, port_value: 80 }
  db_grant:
    # Multi-tenant: the app CREATEs a database per organization at runtime,
    # so the DB user needs global privileges (mirrors upstream init.sql).
    content: |
      GRANT ALL PRIVILEGES ON *.* TO 'bigcapital'@'%' WITH GRANT OPTION;
      FLUSH PRIVILEGES;

services:
  db:
    image: mariadb:11@sha256:be1ef4fe5f14589325c08a41c76334097ce66c86264b75e1d28342c742782a61
    container_name: jabali-app-{{ .Slug }}-db
    restart: unless-stopped
    environment:
      MYSQL_DATABASE: "bigcapital_system"
      MYSQL_USER: "bigcapital"
      MYSQL_PASSWORD: {{ q (index .Env "DB_PASSWORD") }}
      MYSQL_ROOT_PASSWORD: {{ q (index .Env "DB_ROOT_PASSWORD") }}
    configs:
      - source: db_grant
        target: /docker-entrypoint-initdb.d/10-grant.sql
    volumes:
      - {{ .DataRoot }}/db:/var/lib/mysql
    healthcheck:
      test: ["CMD-SHELL", "healthcheck.sh --connect --innodb_initialized"]
      interval: 15s
      timeout: 10s
      retries: 10
      start_period: 60s

  redis:
    image: redis:7@sha256:b2b95679e3b46fb51864949ed25ea976fc3a6bcc00a40a1bc00d568cb2822e50
    container_name: jabali-app-{{ .Slug }}-redis
    restart: unless-stopped
    volumes:
      - {{ .DataRoot }}/redis:/data

  gotenberg:
    image: gotenberg/gotenberg:7@sha256:d03b8a04c6e6c5e568b38f57352266dee4674849b71818774025f8f48d869a9a
    container_name: jabali-app-{{ .Slug }}-gotenberg
    restart: unless-stopped

  minio:
    image: minio/minio:latest@sha256:14cea493d9a34af32f524e538b8346cf79f3321eff8e708c1e2960462bd8936e
    container_name: jabali-app-{{ .Slug }}-minio
    restart: unless-stopped
    command: server /data --console-address ":9001"
    environment:
      MINIO_ROOT_USER: "bigcapital"
      MINIO_ROOT_PASSWORD: {{ q (index .Env "MINIO_ROOT_PASSWORD") }}
    volumes:
      - {{ .DataRoot }}/minio:/data
    healthcheck:
      test: ["CMD-SHELL", "mc ready local || curl -fsS http://127.0.0.1:9000/minio/health/live || exit 1"]
      interval: 15s
      timeout: 10s
      retries: 10
      start_period: 20s

  createbucket:
    image: minio/mc:latest@sha256:a7fe349ef4bd8521fb8497f55c6042871b2ae640607cf99d9bede5e9bdf11727
    container_name: jabali-app-{{ .Slug }}-createbucket
    depends_on:
      minio:
        condition: service_healthy
    # The password reaches the shell as an env var instead of being spliced
    # into the script, so any character in it stays data. "$$" is compose's
    # escape for a literal "$".
    environment:
      MINIO_ROOT_PASSWORD: {{ q (index .Env "MINIO_ROOT_PASSWORD") }}
    entrypoint:
      - sh
      - -c
      - 'mc alias set bc http://minio:9000 bigcapital "$$MINIO_ROOT_PASSWORD" && mc mb --ignore-existing bc/bigcapital && echo bucket-ready'

  migration:
    image: {{ .ImageChannel }}
    container_name: jabali-app-{{ .Slug }}-migration
    depends_on:
      db:
        condition: service_healthy
    environment:
      DB_HOST: "db"
      DB_USER: "bigcapital"
      DB_PASSWORD: {{ q (index .Env "DB_PASSWORD") }}
      DB_CHARSET: "utf8"
      SYSTEM_DB_NAME: "bigcapital_system"
      TENANT_DB_NAME_PERFIX: "bigcapital_tenant_"
    entrypoint: ["sh", "-c", "cd packages/server && node dist/cli.js system:migrate:latest && node dist/cli.js tenants:migrate:latest"]

  server:
    image: {{ .ImageChannel }}
    container_name: jabali-app-{{ .Slug }}-server
    restart: unless-stopped
    depends_on:
      db:
        condition: service_healthy
      redis:
        condition: service_started
      migration:
        condition: service_completed_successfully
      createbucket:
        condition: service_completed_successfully
    environment:
      DB_HOST: "db"
      DB_USER: "bigcapital"
      DB_PASSWORD: {{ q (index .Env "DB_PASSWORD") }}
      DB_CHARSET: "utf8"
      SYSTEM_DB_NAME: "bigcapital_system"
      TENANT_DB_NAME_PERFIX: "bigcapital_tenant_"
      REDIS_HOST: "redis"
      REDIS_PORT: "6379"
      QUEUE_HOST: "redis"
      QUEUE_PORT: "6379"
      JWT_SECRET: {{ q (index .Env "JWT_SECRET") }}
      BASE_URL: "https://{{ .Domain }}"
      SIGNUP_DISABLED: "false"
      SIGNUP_EMAIL_CONFIRMATION: "false"
{{- if (index .Env "SMTP_HOST") }}
      # Operator-supplied SMTP (GH #322) — values q-escaped so special chars
      # (e.g. API-key passwords) can't break the rendered compose YAML.
      MAIL_HOST: {{ q (index .Env "SMTP_HOST") }}
      MAIL_PORT: {{ q (or (index .Env "SMTP_PORT") "587") }}
      MAIL_USERNAME: {{ q (index .Env "SMTP_USER") }}
      MAIL_PASSWORD: {{ q (index .Env "SMTP_PASSWORD") }}
      MAIL_SECURE: "{{ if eq (index .Env "SMTP_PORT") "465" }}true{{ else }}false{{ end }}"
      MAIL_FROM_NAME: {{ q (or (index .Env "SMTP_FROM_NAME") "Bigcapital") }}
      MAIL_FROM_ADDRESS: {{ q (or (index .Env "SMTP_FROM") (printf "bigcapital@%s" .Domain)) }}
{{- end }}
      GOTENBERG_URL: "http://gotenberg:3000"
      GOTENBERG_DOCS_URL: "http://server:3000/public/"
      EXCHANGE_RATE_SERVICE: "open-exchange-rate"
      S3_ENDPOINT: "http://minio:9000"
      S3_REGION: "us-east-1"
      S3_ACCESS_KEY_ID: "bigcapital"
      S3_SECRET_ACCESS_KEY: {{ q (index .Env "MINIO_ROOT_PASSWORD") }}
      S3_BUCKET: "bigcapital"
      S3_FORCE_PATH_STYLE: "true"
    deploy:
      resources:
        limits:
          cpus: "{{ .CPULimit }}"
          memory: {{ .MemoryLimit }}

  webapp:
    image: bigcapitalhq/webapp:v0.25.20@sha256:9e01ab6798882746428f42d710935cf4646b8aea33698bcb2fac607372042386
    container_name: jabali-app-{{ .Slug }}-webapp
    restart: unless-stopped

  proxy:
    image: envoyproxy/envoy:v1.30-latest@sha256:b5cc70f5fe5503858817e897ae1da5d873dc32cbc493790b4e330b8a42c4af9d
    container_name: jabali-app-{{ .Slug }}
    restart: unless-stopped
    depends_on:
      server:
        condition: service_started
      webapp:
        condition: service_started
    configs:
      - source: envoy_config
        target: /etc/envoy/envoy.yaml
    ports:
{{- with index .Ports "http" }}
      - "{{ .BindInterface }}:{{ .HostPort }}:{{ .ContainerPort }}/{{ .Protocol }}"
{{- end }}
