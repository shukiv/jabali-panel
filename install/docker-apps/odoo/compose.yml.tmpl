services:
  odoo:
    image: {{ .ImageChannel }}
    container_name: jabali-app-{{ .Slug }}
    restart: unless-stopped
    depends_on:
      postgres:
        condition: service_healthy
    # --proxy-mode makes Odoo trust X-Forwarded-Proto/Host from the nginx
    # vhost so it derives https URLs + CSRF tokens correctly.
    # --http-interface=0.0.0.0: Odoo 20 listens on 127.0.0.1 inside the
    # container by default, which the published port can't reach. The host
    # side stays loopback-only (the port binding below). 18 and 19 already
    # listened on every interface (GH #1956).
    command: odoo --proxy-mode --http-interface=0.0.0.0
    environment:
      HOST: postgres
      PORT: "5432"
      USER: odoo
      PASSWORD: {{ q (index .Env "POSTGRES_PASSWORD") }}
    volumes:
      - {{ .DataRoot }}/odoo-data:/var/lib/odoo
    ports:
{{- with index .Ports "http" }}
      - "{{ .BindInterface }}:{{ .HostPort }}:{{ .ContainerPort }}/{{ .Protocol }}"
{{- end }}
    deploy:
      resources:
        limits:
          cpus: "{{ .CPULimit }}"
          memory: {{ .MemoryLimit }}

  postgres:
    image: postgres:17-alpine@sha256:dc17045ccfd343b49600570ea734b9c4991cf1c3f3302e67df51e3b402dd55c4
    container_name: jabali-app-{{ .Slug }}-postgres
    restart: unless-stopped
    environment:
      # Odoo connects as a superuser so it can create/drop its own
      # databases from the database manager.
      POSTGRES_USER: odoo
      POSTGRES_PASSWORD: {{ q (index .Env "POSTGRES_PASSWORD") }}
      POSTGRES_DB: postgres
    volumes:
      - {{ .DataRoot }}/postgres:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U odoo"]
      interval: 30s
      timeout: 5s
      retries: 5
      start_period: 20s
