services:
  forgejo:
    image: {{ .ImageChannel }}
    container_name: jabali-app-{{ .Slug }}
    restart: unless-stopped
    environment:
{{- if (index .Env "SMTP_HOST") }}
      # Operator-supplied SMTP (GH #322) — values q-escaped so special chars
      # (e.g. API-key passwords) can't break the rendered compose YAML.
      FORGEJO__mailer__ENABLED: "true"
      FORGEJO__mailer__SMTP_ADDR: {{ q (index .Env "SMTP_HOST") }}
      FORGEJO__mailer__SMTP_PORT: {{ q (or (index .Env "SMTP_PORT") "587") }}
      FORGEJO__mailer__PROTOCOL: "{{ if eq (index .Env "SMTP_PORT") "465" }}smtps{{ else }}smtp+starttls{{ end }}"
      FORGEJO__mailer__USER: {{ q (index .Env "SMTP_USER") }}
      FORGEJO__mailer__PASSWD: {{ q (index .Env "SMTP_PASSWORD") }}
      FORGEJO__mailer__FROM: {{ q (or (index .Env "SMTP_FROM") (printf "forgejo@%s" .Domain)) }}
{{- end }}
      ROOT_URL: "https://{{ .Domain }}/"
{{- range $name, $val := .Env }}
{{- if not (hasPrefix $name "SMTP_") }}
      {{ $name }}: {{ q $val }}
{{- end }}
{{- end }}
    volumes:
      - {{ .DataRoot }}/data:/data
      - {{ .DataRoot }}/config:/etc/gitea
    ports:
{{- with index .Ports "http" }}
      - "{{ .BindInterface }}:{{ .HostPort }}:{{ .ContainerPort }}/{{ .Protocol }}"
{{- end }}
{{- with index .Ports "ssh" }}
{{- if gt .HostPort 0 }}
      - "{{ .BindInterface }}:{{ .HostPort }}:{{ .ContainerPort }}/{{ .Protocol }}"
{{- end }}
{{- end }}
    deploy:
      resources:
        limits:
          cpus: "{{ .CPULimit }}"
          memory: {{ .MemoryLimit }}
    healthcheck:
      test: ["CMD-SHELL", "curl -f http://127.0.0.1:3000/api/healthz || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 30s
