services:
  # One-shot storage seeder. The InvoiceShelf image (serversideup/php,
  # runs as www-data uid 82) ships a populated /var/www/html/storage:
  # the Laravel framework skeleton (framework/{cache,sessions,views}),
  # PDF fonts, and the bundled invoice/estimate templates under
  # app/templates/pdf. A bind mount of an empty host dir MASKS all of
  # that, so the app crash-loops ("valid cache path" / "templates/pdf
  # does not exist"). Upstream sidesteps this with a named volume (Docker
  # seeds it from the image on first mount); jabali bind-mounts to
  # {{ .DataRoot }} for backup, so we seed the skeleton ourselves: tar the
  # image's storage tree into the bind mount, --skip-old-files so a
  # re-up never clobbers user data, then chown to the app's uid. Runs to
  # completion before the app starts (service_completed_successfully).
  init-storage:
    image: {{ .ImageChannel }}
    container_name: jabali-app-{{ .Slug }}-init
    user: "0:0"
    entrypoint:
      - sh
      - -c
      - "cd /var/www/html/storage && tar cf - . | tar xf - --skip-old-files -C /seed && chown -R 82:82 /seed"
    volumes:
      - {{ .DataRoot }}/storage:/seed

  invoiceshelf:
    image: {{ .ImageChannel }}
    container_name: jabali-app-{{ .Slug }}
    restart: unless-stopped
    depends_on:
      init-storage:
        condition: service_completed_successfully
      db:
        condition: service_healthy
    environment:
      APP_ENV: "production"
      APP_DEBUG: "false"
      APP_URL: "https://{{ .Domain }}"
      APP_KEY: {{ q (index .Env "APP_KEY") }}
      DB_CONNECTION: "mariadb"
      DB_HOST: "db"
      DB_PORT: "3306"
      DB_DATABASE: "invoiceshelf"
      DB_USERNAME: "invoiceshelf"
      DB_PASSWORD: {{ q (index .Env "DB_PASSWORD") }}
      CACHE_STORE: "file"
      SESSION_DRIVER: "file"
      SESSION_DOMAIN: "{{ .Domain }}"
      SANCTUM_STATEFUL_DOMAINS: "{{ .Domain }}"
    volumes:
      - {{ .DataRoot }}/storage:/var/www/html/storage
    ports:
{{- with index .Ports "http" }}
      - "{{ .BindInterface }}:{{ .HostPort }}:{{ .ContainerPort }}/{{ .Protocol }}"
{{- end }}
    deploy:
      resources:
        limits:
          cpus: "{{ .CPULimit }}"
          memory: {{ .MemoryLimit }}
    healthcheck:
      test: ["CMD-SHELL", "curl -fsS http://127.0.0.1:8080/ -o /dev/null || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 90s

  db:
    image: mariadb:11@sha256:be1ef4fe5f14589325c08a41c76334097ce66c86264b75e1d28342c742782a61
    container_name: jabali-app-{{ .Slug }}-db
    restart: unless-stopped
    environment:
      MYSQL_DATABASE: "invoiceshelf"
      MYSQL_USER: "invoiceshelf"
      MYSQL_PASSWORD: {{ q (index .Env "DB_PASSWORD") }}
      MYSQL_ROOT_PASSWORD: {{ q (index .Env "MYSQL_ROOT_PASSWORD") }}
    volumes:
      - {{ .DataRoot }}/db:/var/lib/mysql
    healthcheck:
      test: ["CMD-SHELL", "healthcheck.sh --connect --innodb_initialized"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 60s
