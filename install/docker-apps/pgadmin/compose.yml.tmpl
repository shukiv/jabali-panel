services:
  pgadmin:
    image: {{ .ImageChannel }}
    container_name: jabali-app-{{ .Slug }}
    restart: unless-stopped
    # Let pgAdmin reach PostgreSQL running on the host / other containers via
    # the "host.docker.internal" hostname when the operator adds a server.
    extra_hosts:
      - "host.docker.internal:host-gateway"
    environment:
      # Listen on an unprivileged port so the pgadmin (uid 5050) user can bind
      # it; the panel maps the chosen host port to this container port.
      PGADMIN_LISTEN_PORT: "8080"
{{- range $name, $val := .Env }}
      {{ $name }}: {{ q $val }}
{{- end }}
    volumes:
      - {{ .DataRoot }}/data:/var/lib/pgadmin
    ports:
{{- with index .Ports "http" }}
      - "{{ .BindInterface }}:{{ .HostPort }}:{{ .ContainerPort }}/{{ .Protocol }}"
{{- end }}
    deploy:
      resources:
        limits:
          cpus: "{{ .CPULimit }}"
          memory: {{ .MemoryLimit }}
    healthcheck:
      test: ["CMD-SHELL", "wget -qO- http://127.0.0.1:8080/misc/ping || exit 1"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 20s
