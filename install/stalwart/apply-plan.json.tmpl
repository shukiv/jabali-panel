[
  {
    "@type": "create",
    "object": "x:Directory",
    "value": {
      "#sql-directory": {
        "@type": "Sql",
        "description": "Jabali panel mailboxes (authoritative; see ADR-0042)",
        "store": {
          "@type": "MySql",
          "host": "127.0.0.1",
          "port": 3306,
          "database": "jabali_panel",
          "authUsername": "jabali-stalwart-ro",
          "authSecret": {
            "@type": "Value",
            "secret": "{{.MariaDBPassword}}"
          },
          "useTls": false,
          "allowInvalidCerts": false
        },
        "columnEmail": "email_cached",
        "columnSecret": "password_hash",
        "columnClass": null,
        "columnDescription": null,
        "queryLogin": "SELECT email_cached, password_hash FROM mailboxes WHERE email_cached = ? AND is_disabled = 0",
        "queryRecipient": "SELECT u.email_cached, u.password_hash FROM (SELECT ? AS lookup) input JOIN (SELECT m.email_cached AS email_cached, m.password_hash AS password_hash, m.email_cached AS match_key FROM mailboxes m WHERE m.is_disabled = 0 UNION ALL SELECT mb.email_cached, mb.password_hash, g.email_cached AS match_key FROM mail_groups g JOIN mail_group_members gm ON gm.group_id = g.id JOIN mailboxes mb ON mb.id = gm.mailbox_id WHERE g.has_mailbox = 1 AND mb.is_disabled = 0) u ON (u.match_key = input.lookup OR u.email_cached = (SELECT mb2.email_cached FROM email_forwarders f JOIN domains d ON d.id = f.domain_id JOIN mailboxes mb2 ON mb2.id = f.mailbox_id WHERE f.enabled = 1 AND f.type = 'alias' AND CONCAT(f.local_part, '@', d.name) = input.lookup LIMIT 1))",
        "queryMemberOf": null,
        "queryEmailAliases": "SELECT CONCAT(f.local_part, '@', d.name) AS alias FROM email_forwarders f JOIN domains d ON d.id = f.domain_id JOIN mailboxes m ON m.id = f.mailbox_id WHERE f.enabled = 1 AND f.type = 'alias' AND m.email_cached = ?"
      }
    }
  },

  {
    "@type": "update",
    "object": "x:Authentication",
    "id": "singleton",
    "value": {
      "directoryId": "#sql-directory",
      "passwordHashAlgorithm": "bcrypt"
    }
  },

  {
    "@type": "create",
    "object": "x:NetworkListener",
    "value": {
      "#smtp-25": {
        "name": "smtp-25",
        "bind": {"0.0.0.0:25": true},
        "protocol": "smtp",
        "useTls": false,
        "tlsImplicit": false,
        "socketReuseAddress": true,
        "socketReusePort": false,
        "socketNoDelay": true
      },
      "#smtp-submissions-465": {
        "name": "smtp-submissions-465",
        "bind": {"0.0.0.0:465": true},
        "protocol": "smtp",
        "useTls": true,
        "tlsImplicit": true,
        "socketReuseAddress": true,
        "socketReusePort": false,
        "socketNoDelay": true
      },
      "#smtp-submission-587": {
        "name": "smtp-submission-587",
        "bind": {"0.0.0.0:587": true},
        "protocol": "smtp",
        "useTls": true,
        "tlsImplicit": false,
        "socketReuseAddress": true,
        "socketReusePort": false,
        "socketNoDelay": true
      },
      "#imap-993": {
        "name": "imap-993",
        "bind": {"0.0.0.0:993": true},
        "protocol": "imap",
        "useTls": true,
        "tlsImplicit": true,
        "socketReuseAddress": true,
        "socketReusePort": false,
        "socketNoDelay": true
      },
      "#jmap-loopback": {
        "name": "jmap-loopback",
        "bind": {"127.0.0.1:8446": true},
        "protocol": "http",
        "useTls": false,
        "tlsImplicit": false,
        "socketReuseAddress": true,
        "socketReusePort": false,
        "socketNoDelay": true
      },
      "#internal-loopback": {
        "name": "internal-loopback",
        "bind": {"127.0.0.1:18181": true},
        "protocol": "http",
        "useTls": false,
        "tlsImplicit": false,
        "socketReuseAddress": true,
        "socketReusePort": false,
        "socketNoDelay": true
      }
    }
  },

  {
    "@type": "update",
    "object": "x:SpamSettings",
    "id": "singleton",
    "value": {
      "enable": true,
      "trustContacts": true,
      "trustReplies": true,
      "scoreSpam": 5.0,
      "scoreReject": 15.0,
      "scoreDiscard": 20.0,
      "spamFilterRulesUrl": "file:///opt/stalwart/share/spam-filter-rules.json.gz"
    }
  },

  {
    "@type": "update",
    "object": "x:Security",
    "id": "singleton",
    "value": {
      "authBanRate": null,
      "abuseBanRate": null,
      "scanBanRate": null
    }
  },

  {
    "@type": "create",
    "object": "x:Tracer",
    "value": {
      "#jabali-mail-bf-stdout": {
        "@type": "Stdout",
        "enable": true,
        "level": "debug",
        "lossy": false,
        "ansi": false,
        "buffered": false
      },
      "#jabali-delivery-log": {
        "@type": "Log",
        "enable": true,
        "level": "info",
        "path": "/var/log/stalwart",
        "prefix": "delivery",
        "rotate": "daily",
        "ansi": false,
        "multiline": false,
        "lossy": false,
        "eventsPolicy": "include",
        "events": {
          "queue.message-queued": true,
          "queue.authenticated-message-queued": true,
          "delivery.completed": true,
          "delivery.failed": true
        }
      }
    }
  },

  {
    "@type": "update",
    "object": "x:Calendar",
    "id": "singleton",
    "value": {
      "defaultDisplayName": "Personal"
    }
  },

  {
    "@type": "update",
    "object": "x:AddressBook",
    "id": "singleton",
    "value": {
      "defaultDisplayName": "Personal"
    }
  },

  {
    "@type": "update",
    "object": "x:Email",
    "id": "singleton",
    "value": {
      "defaultFolders": {
        "inbox": { "name": "Inbox", "create": true, "subscribe": true },
        "drafts": { "name": "Drafts", "create": true, "subscribe": true },
        "sent": { "name": "Sent", "create": true, "subscribe": true },
        "junk": { "name": "Junk", "create": true, "subscribe": true },
        "trash": { "name": "Trash", "create": true, "subscribe": true },
        "archive": { "name": "Archive", "create": true, "subscribe": true }
      }
    }
  }
]
