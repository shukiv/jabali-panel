# AppArmor profile — jabali-fpm-app (GH #690)
#
# Confines per-user PHP-FPM workloads (WordPress + other tenant PHP). Attaches
# to the fpm-exec wrapper (/usr/local/libexec/jabali/fpm-exec), which execs
# php-fpm<ver> `ix` (inherit), so the workers run under this profile too.
#
# Ships in COMPLAIN mode: it only LOGS would-deny events (apparmor="ALLOWED"),
# never blocks — so it can never break a running site. The operator reviews
# per-profile soak-readiness (GH #688: 0 would-deny over the window) and flips
# to enforce per-host via `jabali apparmor flip-mature --profile jabali-fpm-app`.
#
# Kernel-gated: install_apparmor() skips ALL jabali profiles on kernels lacking
# /sys/kernel/security/apparmor/features/unix (broken unix-socket mediation),
# so this is never loaded where it would EACCES the FPM listen socket.
#
# This is a shared WORKLOAD-CLASS profile (all per-user FPM masters exec the same
# fpm-exec path); per-tenant filesystem isolation stays with POSIX ownership.
# The profile's job is defense-in-depth: deny a compromised tenant PHP access to
# system secrets, other users' homes, and arbitrary execution.
# GH #705: pin AppArmor 3.0 ABI — predates unix-socket mediation, so
# these broken-mediation kernels (Debian 13/Ubuntu 24.04) SKIP unix
# mediation for this profile; attaching it can't EACCES a unix connect()
# while still confining files/caps/network. Verified on .86.
abi <abi/3.0>,

#include <tunables/global>

profile jabali-fpm-app /usr/local/libexec/jabali/fpm-exec flags=(attach_disconnected) {
  #include <abstractions/base>
  #include <abstractions/nameservice>

  # fpm-exec wrapper (bash) reads the runtime version then execs php-fpm.
  /usr/local/libexec/jabali/fpm-exec r,
  /bin/bash rix,
  /usr/bin/bash rix,
  # PHP mail() runs sendmail_path via popen(3) — that is `/bin/sh -c`, and
  # Debian's /bin/sh is dash. Without these the enforce-mode profile kills
  # the sh exec before the shim's Px transition is even reached (JAB-230).
  /bin/sh rix,
  /bin/dash rix,
  /usr/bin/dash rix,
  /usr/bin/cat rix,
  /run/php/jabali-*/phpver r,
  /usr/sbin/php-fpm* rix,

  # PHP runtime + per-user pool config.
  /etc/php/** r,
  /usr/lib/php/** mr,
  /etc/jabali-panel/fpm/*.conf r,
  # snuffleupagus rules (GH #359): the PHP ext reads its config at worker
  # startup; without this the worker fatals "Could not open ... active.rules:
  # Permission denied" and php-fpm 502s.
  /etc/jabali/snuffleupagus/ r,
  /etc/jabali/snuffleupagus/** r,

  # Microsoft ODBC Driver for SQL Server (sqlsrv / pdo_sqlsrv). The extension
  # dlopen()s the driver at connect time, so the profile — not open_basedir —
  # gates it. Without these the load fails and sqlsrv reports IMSSP -49
  # "This extension requires the Microsoft ODBC Driver for SQL Server" even
  # though the driver is installed, which reads as a missing-package problem
  # and sends operators down a reinstall rabbit hole (newzaps 2026-07-19:
  # denial was on /opt/microsoft/ while msodbcsql18 had been installed for a
  # month). Read-only; drivers are root-owned so this grants no tenant write.
  /opt/microsoft/ r,
  /opt/microsoft/** mr,
  /etc/odbcinst.ini r,
  /etc/odbc.ini r,

  # Tenant docroots (POSIX perms enforce per-user isolation; this layer bounds
  # escape to system files, not cross-tenant). Two layouts: native jabali +
  # cPanel/DA use domains/<dom>/public_html; HestiaCP-migrated accounts use
  # web/<dom>/public_html (JAB-37 — the enforced profile denied restored Nextcloud
  # PHP under web/ even though POSIX perms + open_basedir allowed it).
  /home/*/domains/*/ r,
  /home/*/domains/*/public_html/** rwkl,
  /home/*/web/*/ r,
  /home/*/web/*/public_html/** rwkl,
  # Tenant PHP error logs (cPanel/DA convention ~/logs/php.error.log —
  # tenants point error_log there via php.ini/ini_set; migrated accounts
  # arrive with it preset). Owner-scoped: a worker only touches its own
  # user's logs dir. No exec. Live enforce denial observed 2026-08-01.
  owner /home/*/logs/ r,
  owner /home/*/logs/** rw,

  # Temp + sessions.
  /tmp/ r,
  /tmp/** rwk,
  /var/lib/php/sessions/** rwk,
  /run/php/** rw,

  # PHP mail() submission shim (JAB-230). Px — the shim runs under its OWN
  # child profile below, so a compromised tenant worker exec'ing it gains
  # network submit + cred-read only, and the shim gains none of the
  # docroot/session write surface of this profile.
  /usr/local/libexec/jabali/jabali-sendmail Px -> jabali-sendmail,

  # Backing services over unix sockets.
  unix (connect, receive, send) type=stream,
  /run/redis/redis.sock rw,
  /run/mysqld/ r,
  /run/mysqld/mysqld.sock rw,
  # PHP's mysqli.default_socket is /var/run/mysqld/mysqld.sock (Debian).
  /var/run/mysqld/mysqld.sock rw,

  # Logs.
  /var/log/php*.log w,

  # Hard denies — a tenant RCE must never reach these even if a POSIX bug existed.
  deny /etc/shadow r,
  deny /etc/gshadow r,
  deny /root/** rwklx,
  deny /home/*/.ssh/** rwklx,
  deny /etc/jabali-panel/migration-secrets/** rwklx,
}

# jabali-sendmail (JAB-230) — child profile for the PHP mail() shim. Runs as
# the tenant uid (inherited from the FPM worker). Needs exactly: read its own
# binary, read the relay-credential tree (POSIX 0640 root:<usergroup> already
# scopes WHICH creds this uid can open; the profile bounds the reachable
# paths), TCP to the local submission port, TLS roots, and syslog. No exec,
# no writes, no /home. Lives in this file so it loads/flips with the parent
# (aa-complain/aa-enforce operate per-file) — if the parent is already
# enforced on a host, this loads enforced too, which is why `make aa-smoke`
# must pass before shipping any edit here.
profile jabali-sendmail /usr/local/libexec/jabali/jabali-sendmail flags=(attach_disconnected) {
  #include <abstractions/base>
  #include <abstractions/nameservice>
  #include <abstractions/openssl>
  #include <abstractions/ssl_certs>

  /usr/local/libexec/jabali/jabali-sendmail mr,

  # Go runtime introspection (GOMAXPROCS reads the cgroup limits at start).
  # Observed as would-deny on the testserver soak; read-only metadata.
  owner /proc/*/cgroup r,
  owner /proc/*/mountinfo r,
  /sys/fs/cgroup/ r,
  /sys/fs/cgroup/** r,

  # Relay credentials — traverse + read only.
  /etc/jabali-panel/sendmail/ r,
  /etc/jabali-panel/sendmail/*/ r,
  /etc/jabali-panel/sendmail/*/*.cred r,

  # Submission to Stalwart on 127.0.0.1:587 (STARTTLS).
  network inet stream,
  network inet6 stream,

  # One syslog line per attempt (mail facility).
  /dev/log w,

  # A message-parsing bug must never become a filesystem primitive. The `r`
  # matters twice: the shim inherits the FPM worker's open fd on the tenant's
  # .php script (popen keeps parent fds), and an explicit deny both revokes
  # that fd AND silences the per-send file_inherit audit noise it would
  # otherwise log in enforce mode. The shim needs nothing from /home.
  deny /home/** rwklx,
  deny /etc/shadow r,
  deny /etc/gshadow r,
  deny /root/** rwklx,
}
