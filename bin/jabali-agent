    // Autoresponder/vacation requires ManageSieve protocol (future enhancement).
    logger('Warning: Autoresponder '.($active ? 'enable' : 'disable')." requested for: $email but Sieve management via REST API is not supported in Stalwart v0.15. ManageSieve client support required.");

    return ['success' => true];
}

