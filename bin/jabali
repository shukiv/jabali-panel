#!/usr/bin/env php
<?php

declare(strict_types=1);
/**
 * Jabali CLI - Command Line Interface for Jabali Panel
 *
 * Thin shim that routes `jabali <noun> <verb>` to artisan commands.
 * Only the `update` command is handled directly (it rebuilds the app).
 */
define('JABALI_ROOT', dirname(__DIR__));

// Read version from VERSION file
$versionFile = JABALI_ROOT.'/VERSION';
$version = '0.0.0';
if (file_exists($versionFile)) {
    $content = file_get_contents($versionFile);
    if (preg_match('/VERSION=(.+)/', $content, $m)) {
        $version = trim($m[1]);
    }
}
define('VERSION', $version);

// Colors (used by update command only)
define('C_RESET', "\033[0m");
define('C_RED', "\033[31m");
define('C_GREEN', "\033[32m");
define('C_YELLOW', "\033[33m");
define('C_CYAN', "\033[36m");
define('C_BOLD', "\033[1m");

chdir(JABALI_ROOT);

// Bootstrap Laravel
require 'vendor/autoload.php';
$app = require 'bootstrap/app.php';
$kernel = $app->make(Illuminate\Contracts\Console\Kernel::class);
$kernel->bootstrap();

// Parse arguments
$args = $_SERVER['argv'];
array_shift($args);

$command = $args[0] ?? '';
$subcommand = $args[1] ?? '';

// Command aliases
$aliases = [
    'wordpress' => 'wp',
    'database' => 'db',
    'email' => 'mail',
];
$command = $aliases[$command] ?? $command;

// Handle special commands
switch ($command) {
    case '':
    case 'list':
    case '--help':
    case '-h':
        exit(\Illuminate\Support\Facades\Artisan::call('jabali:help', [], new \Symfony\Component\Console\Output\ConsoleOutput));

    case '--version':
    case '-v':
        echo 'Jabali CLI v'.VERSION."\n";
        exit(0);

    case 'update':
        handleUpdate(parseOptions(array_slice($args, 1)));
        exit(0);
}

// Route to artisan command
$artisanCommand = $subcommand ? "jabali:{$command}:{$subcommand}" : "jabali:{$command}";

// If noun:verb didn't match, try noun as standalone command
if (! array_key_exists($artisanCommand, \Illuminate\Support\Facades\Artisan::all())) {
    if (! $subcommand) {
        // No verb — check if this noun has verbs and list them
        $prefix = "jabali:{$command}:";
        $verbs = [];
        foreach (\Illuminate\Support\Facades\Artisan::all() as $name => $cmd) {
            if (str_starts_with($name, $prefix)) {
                $verb = substr($name, strlen($prefix));
                $verbs[$verb] = $cmd->getDescription();
            }
        }

        if (! empty($verbs)) {
            echo C_BOLD."jabali {$command}".C_RESET." — available commands:\n\n";
            ksort($verbs);
            foreach ($verbs as $verb => $desc) {
                echo '  '.C_GREEN.str_pad($verb, 20).C_RESET.C_CYAN.$desc.C_RESET."\n";
            }
            echo "\nUsage: jabali {$command} <verb> [options]\n";
            exit(0);
        }

        fwrite(STDERR, C_RED."Unknown command: jabali {$command}".C_RESET."\n");
        fwrite(STDERR, "Run 'jabali --help' for available commands.\n");
    } else {
        fwrite(STDERR, C_RED."Unknown command: jabali {$command} {$subcommand}".C_RESET."\n");
        fwrite(STDERR, "Run 'jabali --help' for available commands.\n");
    }
    exit(2);
}

// Parse flags and positional args, map to artisan arguments
$artisanArgs = [];
$cmdDefinition = \Illuminate\Support\Facades\Artisan::all()[$artisanCommand]->getDefinition();
$positionalNames = array_keys($cmdDefinition->getArguments());

foreach (parseOptions(array_slice($args, 2)) as $key => $value) {
    if ($key === '_args') {
        foreach ($value as $i => $posValue) {
            if (isset($positionalNames[$i])) {
                $artisanArgs[$positionalNames[$i]] = $posValue;
            }
        }

        continue;
    }
    $artisanArgs["--{$key}"] = $value;
}

exit(\Illuminate\Support\Facades\Artisan::call($artisanCommand, $artisanArgs, new \Symfony\Component\Console\Output\ConsoleOutput));

// ============ ARGUMENT PARSER ============

function parseOptions(array $args): array
{
    $options = ['_args' => []];
    $valueOptions = [
        'admin', 'domain', 'email', 'password', 'user', 'username', 'name',
        'title', 'admin-user', 'admin-email', 'admin-password', 'quota',
        'size', 'path', 'file', 'database', 'host', 'port', 'proto', 'from',
        'type', 'format', 'output', 'lines', 'version', 'config', 'limit',
        'days', 'interval', 'key', 'value', 'target', 'source', 'destination',
        'template', 'zone', 'record', 'ttl', 'priority', 'weight', 'tag',
        'interface', 'ip', 'mask', 'gateway', 'dns',
    ];

    for ($i = 0; $i < count($args); $i++) {
        $arg = $args[$i];

        if (str_starts_with($arg, '--')) {
            $argName = $arg;
            if (str_contains($arg, '=')) {
                [$argName, $argValue] = explode('=', $arg, 2);
                $options[ltrim($argName, '-')] = $argValue;
            } elseif (
                in_array(ltrim($arg, '-'), $valueOptions, true)
                && isset($args[$i + 1])
                && ! str_starts_with($args[$i + 1], '-')
            ) {
                $options[ltrim($arg, '-')] = $args[++$i];
            } else {
                $options[ltrim($arg, '-')] = true;
            }
        } elseif (str_starts_with($arg, '-') && strlen($arg) === 2) {
            $options[ltrim($arg, '-')] = true;
        } else {
            $options['_args'][] = $arg;
        }
    }

    return $options;
}

// ============ UPDATE COMMAND (stays in shim — it rebuilds the app itself) ============

/**
 * Self-update: pulls code, installs deps, builds assets, runs migrations.
 * Cannot be an artisan command because it rebuilds the artisan commands.
 * All shell commands use escapeshellarg() for safe argument handling.
 */
function handleUpdate(array $options): void
{
    if (posix_geteuid() !== 0) {
        fwrite(STDERR, C_RED.'jabali update must be run as root'.C_RESET."\n");
        exit(1);
    }

    $jabaliDir = JABALI_ROOT;
    $wwwUser = 'www-data';

    echo "\n".C_BOLD.'Updating Jabali Panel'.C_RESET."\n";
    echo str_repeat('─', 40)."\n\n";

    $phpVersion = PHP_MAJOR_VERSION.'.'.PHP_MINOR_VERSION;

    // Step 1: Pull latest code
    step('Pulling latest code...');
    // Fix .git ownership before pull (root CLI creates root-owned files, www-data panel can't read them)
    runShell('chown -R '.escapeshellarg($wwwUser).':'.escapeshellarg($wwwUser).' '.escapeshellarg($jabaliDir.'/.git').' 2>/dev/null');
    $pullOutput = runShell('cd '.escapeshellarg($jabaliDir).' && git pull 2>&1');
    if ($pullOutput === false) {
        fwrite(STDERR, C_RED.'✗ git pull failed'.C_RESET."\n");
        exit(1);
    }
    if (str_contains($pullOutput, 'Already up to date')) {
        echo C_YELLOW.'ℹ Already up to date'.C_RESET."\n";
        if (! isset($options['force'])) {
            echo C_GREEN."\nNo updates available.\n".C_RESET;

            return;
        }
        echo C_YELLOW.'ℹ --force specified, continuing anyway'.C_RESET."\n";
    } else {
        echo C_GREEN.'✓ Code updated'.C_RESET."\n";
    }

    // Read new version
    $newVersion = VERSION;
    $versionFile = $jabaliDir.'/VERSION';
    if (file_exists($versionFile)) {
        $content = file_get_contents($versionFile);
        if (preg_match('/VERSION=(.+)/', $content, $m)) {
            $newVersion = trim($m[1]);
        }
    }

    // Step 2: Composer install
    step('Installing dependencies...');
    // Ensure public asset dirs are writable for Filament's post-install upgrade
    foreach (['public/js', 'public/css', 'public/fonts'] as $assetDir) {
        $assetPath = $jabaliDir.'/'.$assetDir;
        if (is_dir($assetPath)) {
            runShell('chown -R '.escapeshellarg($wwwUser).':'.escapeshellarg($wwwUser).' '.escapeshellarg($assetPath).' 2>/dev/null');
        }
    }
    $composerResult = runShell('cd '.escapeshellarg($jabaliDir).' && sudo -u '.escapeshellarg($wwwUser).' composer install --no-interaction --prefer-dist --optimize-autoloader --no-dev 2>&1');
    if ($composerResult === false) {
        fwrite(STDERR, C_RED.'✗ composer install failed'.C_RESET."\n");
        exit(1);
    }
    echo C_GREEN.'✓ Dependencies installed'.C_RESET."\n";

    // Step 3: Build frontend assets
    step('Building frontend assets...');
    $homeDir = trim(runShell('eval echo ~'.escapeshellarg($wwwUser)) ?: '/var/www');
    runShell('mkdir -p '.escapeshellarg($homeDir.'/.npm').' && chown -R '.escapeshellarg($wwwUser).':'.escapeshellarg($wwwUser).' '.escapeshellarg($homeDir.'/.npm').' 2>/dev/null');
    if (is_dir($jabaliDir.'/public/build')) {
        runShell('chown -R '.escapeshellarg($wwwUser).':'.escapeshellarg($wwwUser).' '.escapeshellarg($jabaliDir.'/public/build').' 2>/dev/null');
    }
    $npmResult = runShell('cd '.escapeshellarg($jabaliDir).' && sudo -u '.escapeshellarg($wwwUser).' npm ci 2>&1 && sudo -u '.escapeshellarg($wwwUser).' npm run build 2>&1');
    if ($npmResult === false) {
        echo C_YELLOW.'⚠ npm build failed — frontend may be stale'.C_RESET."\n";
    } else {
        echo C_GREEN.'✓ Assets built'.C_RESET."\n";
    }

    // Step 4: Maintenance mode
    step('Entering maintenance mode...');
    runShell('cd '.escapeshellarg($jabaliDir).' && sudo -u '.escapeshellarg($wwwUser).' php artisan down --retry=60 --refresh=15 2>&1');

    // Step 5: Run migrations
    step('Running database migrations...');
    $migrateResult = runShell('cd '.escapeshellarg($jabaliDir).' && sudo -u '.escapeshellarg($wwwUser).' php artisan migrate --force 2>&1');
    if ($migrateResult === false) {
        echo C_YELLOW.'⚠ Migrations failed — check manually: php artisan migrate --force'.C_RESET."\n";
    } else {
        echo C_GREEN.'✓ Migrations complete'.C_RESET."\n";
    }

    // Step 6: Clear and rebuild caches
    step('Rebuilding caches...');
    $artisan = 'cd '.escapeshellarg($jabaliDir).' && sudo -u '.escapeshellarg($wwwUser).' php artisan';
    runShell("{$artisan} optimize:clear 2>&1");
    runShell("{$artisan} config:cache 2>&1");
    runShell("{$artisan} route:cache 2>&1");
    runShell("{$artisan} view:cache 2>&1");
    runShell("{$artisan} queue:restart 2>&1");
    echo C_GREEN.'✓ Caches rebuilt'.C_RESET."\n";

    // Step 7: Exit maintenance mode
    step('Exiting maintenance mode...');
    runShell("{$artisan} up 2>&1");
    echo C_GREEN.'✓ Panel is live'.C_RESET."\n";

    // Step 8: Upgrade infrastructure (output shown directly)
    step('Upgrading infrastructure...');
    $installScript = $jabaliDir.'/install.sh';
    if (file_exists($installScript)) {
        $infraExitCode = 0;
        passthru('bash '.escapeshellarg($installScript).' upgrade', $infraExitCode);
        if ($infraExitCode !== 0) {
            echo C_YELLOW.'⚠ Infrastructure upgrade had issues — check output above'.C_RESET."\n";
        } else {
            echo C_GREEN.'✓ Infrastructure updated'.C_RESET."\n";
        }
    } else {
        runShell('systemctl restart jabali-agent 2>/dev/null');
        $fpmService = "php{$phpVersion}-fpm";
        if (file_exists("/run/php/php{$phpVersion}-fpm-panel.sock")) {
            $fpmService = "php{$phpVersion}-fpm-panel";
        }
        runShell('systemctl restart '.escapeshellarg($fpmService).' 2>/dev/null');
        runShell('systemctl reload nginx 2>/dev/null');
        echo C_GREEN.'✓ Services restarted'.C_RESET."\n";
    }

    // Step 9: Update installed addons
    $addonBinaries = [
        'jabali-backup' => '/usr/local/bin/jabali-backup',
        'jabali-security' => '/usr/local/bin/jabali-security',
        'jabali-isolator' => '/usr/local/bin/jabali-isolator',
    ];
    $addonUpdated = false;
    foreach ($addonBinaries as $addon => $binary) {
        if (file_exists($binary)) {
            if (! $addonUpdated) {
                step('Updating installed addons...');
                $addonUpdated = true;
            }
            $updateResult = runShell(escapeshellarg($binary).' update 2>&1');
            if ($updateResult === false) {
                echo C_YELLOW."  ⚠ {$addon} update failed".C_RESET."\n";
            } else {
                echo C_GREEN."  ✓ {$addon} updated".C_RESET."\n";
            }
        }
    }

    // Fix .git ownership after update so panel (www-data) can check for updates
    runShell('chown -R '.escapeshellarg($wwwUser).':'.escapeshellarg($wwwUser).' '.escapeshellarg($jabaliDir.'/.git').' 2>/dev/null');

    echo "\n".C_GREEN.C_BOLD.'Update complete!'.C_RESET." Jabali Panel v{$newVersion}\n\n";
}

function step(string $msg): void
{
    echo C_CYAN.'  → '.C_RESET.$msg."\n";
}

/**
 * Run a shell command and return output, or false on failure.
 * Only used for trusted, internally-constructed commands — no user input.
 */
function runShell(string $cmd): string|false
{
    $output = [];
    $exitCode = 0;
    exec($cmd, $output, $exitCode);
    $result = implode("\n", $output);

    return $exitCode === 0 ? $result : false;
}
