parameters:
    level: 0
    # These files are deployed INTO the main jabali panel at install time,
    # so they legitimately reference Laravel/Filament/AgentClient classes
    # from jabali's vendor. Bootstrap from there so PHPStan can resolve them.
    bootstrapFiles:
        - ../jabali/vendor/autoload.php
    paths:
        - lib
        - panel
    shipmonkDeadCode:
        usageExcluders:
            tests:
                enabled: true
