parameters:
    level: 0
    # These files are deployed INTO the main jabali panel at install time,
    # so they legitimately reference Laravel/Filament/AgentClient classes
    # from jabali's vendor. Bootstrap from there so PHPStan can resolve them.
    bootstrapFiles:
        - ../jabali/vendor/autoload.php
    paths:
        - lib
        - panel
    # Defensive scoping: patterns list paths even when currently clean so
    # silences don't silently evaporate if someone renames a file.
    reportUnmatchedIgnoredErrors: false
    shipmonkDeadCode:
        usageExcluders:
            tests:
                enabled: true
    ignoreErrors:
        # ─── Framework-entry-point false positives ────────────────────────────
        # shipmonk's LaravelUsageProvider recognizes console commands, jobs,
        # service providers, form requests, etc. — but NOT Filament, Livewire,
        # or interface-dispatched adapter methods.

        # Filament pages + Livewire traits — public methods are callable from
        # Blade (wire:click / wire:submit) and Filament lifecycle (mount,
        # updatedFoo, action builders) runs through reflection.
        -
            identifier: shipmonk.deadMethod
            paths:
                - panel/filament/*
                - panel/Filament/*
                - panel/Concerns/*
                - panel/backup/Concerns/*
        -
            identifier: shipmonk.deadProperty.neverRead
            paths:
                - panel/filament/*
                - panel/Filament/*
                - panel/Concerns/*
                - panel/backup/Concerns/*

        # FileBrowserAdapter implementation — ResticSnapshotAdapter satisfies
        # the main jabali panel's FileBrowserAdapter interface and is resolved
        # polymorphically via ->files() / ->archiver() / ->permissions() by
        # the file-browser UI. Shipmonk can't see through the interface.
        -
            identifier: shipmonk.deadMethod
            paths:
                - panel/backup/Adapters/*
        -
            identifier: shipmonk.deadProperty.neverRead
            paths:
                - panel/backup/Adapters/*
